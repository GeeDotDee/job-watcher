# Copy to .env and edit. Nothing in here is secret; this repo uses no API keys.

# Company career pages to poll, as ats:board-slug (greenhouse, lever or ashby), comma-separated.
COMPANY_BOARDS=greenhouse:your-board-slug,lever:another-slug,ashby:a-third-slug

# Optional overrides
# CANDIDATE_FILE=candidate.json
# CLAUDE_MODEL=sonnet
# SCAN_INTERVAL_MINUTES=15
# TAILOR_PER_SCAN=6
# TAILOR_PER_DAY=40
# SUBMIT_MIN_MATCH=75
